# Database (@libsql/client — same driver locally and in prod)
# Local dev: point at a local file. Prod: Turso URL + auth token.
TURSO_URL=file:./db/local.db
TURSO_AUTH_TOKEN=

# Session cookie signing/encryption secret (required by nuxt-auth-utils, min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# Single shared PIN for the app login (see plan: single PIN, no user table)
APP_PIN=

# Bearer token the Python worker uses to call /api/internal/garmin/ingest
INGEST_TOKEN=

# IANA timezone used to resolve shift starts_at/ends_at (DST-aware) — set to her actual timezone
APP_TIMEZONE=Europe/Paris
